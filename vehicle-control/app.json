{
  "expo": {
    "name": "Vehicle Control",
    "slug": "vehicle-control",
    "version": "1.0.1",
    "scheme": "vehicle-control",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vehicle.control",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "La app usa Bluetooth para conectar el vehiculo."
      }
    },
    "android": {
      "package": "com.vehicle.control",
      "versionCode": 2,
      "minSdkVersion": 23,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
